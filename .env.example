# Copie ce fichier en ".env" (sans ".example") et remplis les vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être partagé ni envoyé sur GitHub (voir .gitignore).

# Clé secrète utilisée par Flask pour signer les sessions.
# Génère la tienne avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplace-moi

# Hash du mot de passe administrateur (jamais le mot de passe en clair !).
# Génère-le avec la commande fournie dans le README, section "Mot de passe admin".
ADMIN_PASSWORD_HASH=remplace-moi

# "development" en local, "production" une fois en ligne (active le cookie sécurisé HTTPS).
FLASK_ENV=development
